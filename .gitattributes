# Force LF line endings
* text=auto eol=lf

# Shell scripts must be LF
*.sh text eol=lf

# Config files must be LF
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.json text eol=lf

# Python files must be LF
*.py text eol=lf

# Markdown
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.aac binary
*.m4a binary
*.wav binary
*.db binary
