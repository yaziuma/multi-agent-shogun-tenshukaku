# shogun-web-v2 whitelist .gitignore
# Deny all by default
*

# Allow directory traversal
!*/

# Allow root config files
!.gitignore
!.gitattributes
!.python-version
!README.md
!README_ja.md
!main.py
!pyproject.toml
!start.sh
!restart.sh

# Allow .github directory (CI/CD)
!.github/
!.github/**

# Allow .claude directory and contents
!.claude/
!.claude/**

# Allow assets directory (screenshots only)
!assets/
!assets/screenshots/
!assets/screenshots/**

# Allow config directory (wildcard + deny dangerous patterns)
!config/
!config/settings.yaml.example

# Allow static directory
!static/
!static/**

# Allow templates directory
!templates/
!templates/**

# Allow tests directory
!tests/
!tests/**

# Allow ws (WebSocket) directory
!ws/
!ws/**
